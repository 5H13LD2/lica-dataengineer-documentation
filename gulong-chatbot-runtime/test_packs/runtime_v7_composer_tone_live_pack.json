{
  "pack_id": "runtime-v7-composer-tone-v1",
  "endpoint": "/gulong/v7/chat/tester",
  "scenarios": [
    {
      "id": "taglish_compound_payment",
      "user_text": "Pwede ba Home Credit? Kung Pay Later sa Yokohama, available ba ang 3 months installment 0%? At available ba ang BPI 6 months installment 0%?",
      "expected": {
        "minimum_commercial_claims": 3,
        "required_patterns": [
          "home credit",
          "yokohama",
          "3\\s*[- ]?month",
          "bpi\\s*6\\s*[- ]?month",
          "pay later",
          "tire size"
        ],
        "forbidden_patterns": [
          "bpi (?:is|ay) not (?:currently )?supported",
          "6\\s*%\\s*interest",
          "straight credit|debit"
        ]
      }
    },
